<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>27cbe13d-36e2-4d53-bb6f-c0d704923fb7</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <!--
      AutoMapper was dropped in favour of explicit mapping. 13.0.1 carries
      NU1903, a known high-severity advisory, and the two maps it held were
      `CreateMap<Activity, ActivityInfo>()` with no customisation — a dependency,
      a startup assembly scan and a security advisory to save writing out a
      dozen assignments that the compiler would otherwise have checked.
    -->
    <!--
      Ed25519, for the Runner handshake. .NET 8 has no Ed25519 — it arrives in
      the framework later — and this is the pure-managed option, so a container
      needs no native libsodium beside it.
    -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.1" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.0" />
    <!--
      The LTI module validates a platform's `id_token` and signs its own client
      assertions with these. **Neither is a new dependency**: both were already
      in the closure at 7.0.3, pulled by the OpenIdConnect handler above, and are
      promoted to direct references so the version on a signature-validation path
      is stated rather than inherited from a transitive graph that a minor bump
      elsewhere can move.

      Pinned to 7.0.3 for the same reason they are not on 8.x: the ASP.NET
      OpenIdConnect handler that federated sign-in runs on resolves this family,
      and raising it here would raise it there — a change to the sign-in path,
      made as a side effect of an LTI feature, verified by nothing.

      MIT, maintained by Microsoft in `AzureAD/azure-activedirectory-identitymodel-extensions-for-dotnet`,
      shipping stable releases. No alpha or beta package goes on this path, which
      is a constraint the project owner set rather than a preference.
    -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="7.0.3" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="7.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.19.5" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Database\Migrations\" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A background worker's single unit of work is `internal` so nothing in the
      application calls it out of band, and visible to the tests so a sweep can
      be run against a clock somebody turns rather than waited for.
    -->
    <InternalsVisibleTo Include="AlgoJudge.Server.Tests" />
  </ItemGroup>

</Project>
