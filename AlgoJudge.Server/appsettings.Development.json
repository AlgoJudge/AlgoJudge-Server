{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DbConnectionString": "Host=localhost;Database=algojudge;Username=postgres;Password=X"
  },

  // The origins a developer actually serves the Client from. `appsettings.json`
  // names only `https://localhost:5173`, which is the one shape nobody runs:
  // `npm run dev` serves plain HTTP unless VITE_DOTNET_CERT is set, and the
  // browser check suite uses 5180. Every call carries `credentials: "include"`,
  // so an origin missing from this list is not a warning — it is every request
  // failing CORS with nothing in the Server's log to say why.
  //
  // Development only. A deployment names its own origin, or serves both halves
  // from one and needs none of this.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:5180",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5180"
    ]
  }
}
