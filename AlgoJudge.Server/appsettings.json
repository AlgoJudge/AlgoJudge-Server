{
  "Logging": {
    "LogLevel": {
      // **Warning, and Information is not a production level.** Every SQL
      // statement EF Core runs is emitted at Information, and only
      // `Microsoft.AspNetCore` used to be filtered — so `Default` caught it.
      // Measured on two twelve-Runner runs of 150 submissions: 69 192 and
      // 107 372 logged commands, 91-98% of everything the stack emitted, 80.8
      // MiB and 113 MiB. A contest of three thousand submissions is well over a
      // gigabyte of it, on the same disk as the database.
      //
      // Filtering that one category would have fixed the volume and left the
      // rule unstated. The rule is the point: a production log carries what
      // somebody has to act on — which is why the exception below is drawn
      // around this product's own code rather than around one library.
      "Default": "Warning",

      // **Our own code stays at Information, and the frameworks do not.** A
      // logger's category is the full name of the type that asked for it, so
      // everything this Server writes is under `AlgoJudge.` and everything
      // noisy is not. That distinction is the whole of the rule: what this
      // product chose to say is worth saying — a Runner registered and awaiting
      // approval, deletion requests carried out, a sweeper standing aside for
      // another instance — and what a library says about its own internals is
      // not, on a machine judging a contest.
      "AlgoJudge": "Information",

      // Without it a healthy start prints nothing at all, and an operator
      // watching `compose logs` cannot tell a Server that came up from one that
      // is silently failing to. Three lines per start.
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DbConnectionString": "Host=localhost;Database=algojudge;Username=algojudge;Password=algojudge"
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:5173"]
  }
}
