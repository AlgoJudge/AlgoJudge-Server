{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // **Every SQL statement, with its full text, was going to stdout.**
      // EF Core emits CommandExecuted at Information, and only
      // `Microsoft.AspNetCore` was filtered — so `Default` caught it. Measured
      // on two twelve-Runner runs of 150 submissions: 69 192 and 107 372
      // logged commands, **91-98% of everything the stack emitted**, 80.8 MiB
      // and 113 MiB. A contest of three thousand submissions is well over a
      // gigabyte of it, and none of it is a diagnostic anybody asked for.
      //
      // `appsettings.Development.json` deliberately keeps it: seeing the SQL is
      // most of what that file is for.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DbConnectionString": "Host=localhost;Database=algojudge;Username=algojudge;Password=algojudge"
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:5173"]
  }
}
